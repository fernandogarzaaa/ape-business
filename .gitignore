# Dry-run artifacts, regenerated by provisioning/aws/dry-run.js.
# They contain fake test account ids only, but they are outputs, not source.
provisioning/aws/calls.json
provisioning/aws/rollback-calls.json
provisioning/aws/dry-run-report.json
node_modules/
.ape/
.skein/
.fastembed_cache/
.tmp-*/
adam_genome.json
adam_memory.db
*.db
*.log
.eve-output/
target/
.venv/
__pycache__/
# Standalone prebuilt outputs ARE committed:
# `target/` ignores every dir named target; re-include ONLY the vendored ADAM release
# binaries. Chain must re-include each parent dir before its children, then re-ignore
# the rest so build artifacts (debug/, deps/, .fingerprint/, ...) never enter git.
!vendors/adam/target/
vendors/adam/target/*
!vendors/adam/target/release/
vendors/adam/target/release/*
!vendors/adam/target/release/adam-mcp.exe
!vendors/adam/target/release/adam-mcp
!vendors/genesis/dist/
!vendors/eve/dist/
provisioning/data/
provisioning/tenants/*.json
provisioning/deployments/
.env
.env.*
!.env.example
